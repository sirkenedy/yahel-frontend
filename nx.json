{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "{workspaceRoot}/tsconfig.base.json"],
    "production": ["default", "!{projectRoot}/**/*.test.{ts,tsx}"]
  },
  "targetDefaults": {
    "build": { "dependsOn": ["^build"], "inputs": ["production", "^production", { "env": "VITE_APP_URL" }, { "env": "WEBSITE_LOCAL_BUILD" }], "outputs": ["{projectRoot}/dist"], "cache": true },
    "typecheck": { "dependsOn": ["^build"], "inputs": ["default", "^default"], "cache": true },
    "test": { "dependsOn": ["^build"], "inputs": ["default", "^default"], "cache": true }
  },
  "defaultBase": "main"
}
