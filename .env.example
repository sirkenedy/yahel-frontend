VITE_API_URL=http://localhost:3200/api
# Where the public website sends "Sign in" and "Create account". The website's build writes this address into its
# pages and fails unless it is https. A build that is not deployed (local preview, browser tests) is marked on the
# command line with WEBSITE_LOCAL_BUILD=1, as `pnpm build` does; that mark does not belong in this file.
VITE_APP_URL=http://localhost:5173
